// prisma/schema.prisma
// ServiPro — Modelo de datos alineado a la forma real usada por la app
// (denormalizado a propósito: refleja lo que los antiguos stores JSON
// ya guardaban, para poder migrar sin reescribir API routes ni admin UI)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PRODUCTOS (ferretería / tienda)
// ============================================================

model Product {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  slug             String   @unique
  description      String   @default("") @db.Text
  shortDescription String   @default("")
  category         String
  brand            String
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  stock            Int      @default(0)
  images           String[]
  specifications   Json     @default("{}")
  tags             String[]
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  salesCount       Int      @default(0)
  promoDiscountPercent Int?
  promoStartsAt    DateTime?
  promoEndsAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isActive, isFeatured])
  @@index([salesCount])
}

// ============================================================
// LEADS (mini-CRM de contactos de servicios)
// ============================================================

model Lead {
  id               String   @id @default(cuid())
  status           String   @default("new")
  priority         String   @default("medium")
  source           String   @default("website")
  customer         Json
  subject          String   @default("")
  message          String   @default("") @db.Text
  serviceInterest  String   @default("")
  estimatedValue   Decimal? @db.Decimal(10, 2)
  tags             String[]
  activities       Json     @default("[]")
  tasks            Json     @default("[]")
  notes            Json     @default("[]")
  assignedTo       String   @default("")
  lastContactedAt  String   @default("")
  nextFollowUp     String   @default("")
  lostReason       String   @default("")
  leadType         String   @default("general")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PEDIDOS (tienda)
// ============================================================

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  status        String   @default("pending")
  paymentStatus String   @default("pending")
  customer      Json
  items         Json
  subtotal      Decimal  @db.Decimal(10, 2)
  shipping      Decimal  @db.Decimal(10, 2) @default(0)
  discount      Decimal  @db.Decimal(10, 2) @default(0)
  total         Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("")
  adminNotes    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PRESUPUESTOS (servicios)
// ============================================================

model Presupuesto {
  id                String   @id @default(cuid())
  code              String   @unique
  status            String   @default("nuevo")
  serviceType       String
  serviceTitle      String   @default("")
  customer          Json
  description       String   @default("") @db.Text
  details           String   @default("") @db.Text
  estimatedValue    Decimal? @db.Decimal(10, 2)
  finalValue        Decimal? @db.Decimal(10, 2)
  estimatedDuration String   @default("")
  priority          String   @default("media")
  source            String   @default("")
  notes             Json     @default("[]")
  attachments       String[]
  assignedTo        String   @default("")
  scheduledDate     String   @default("")
  calculationData   Json     @default("{}")
  createdBy         String   @default("")
  seguimientoData   Json     @default("{}")
  costosData        Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PORTFOLIO (proyectos)
// ============================================================

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String   @default("") @db.Text
  category    String
  location    String   @default("")
  duration    String   @default("")
  year        String   @default("")
  client      String   @default("")
  image       String   @default("")
  gallery     String[]
  badge       String   @default("neutral")
  size        String   @default("small")
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}

// ============================================================
// SERVICIOS (CMS de servicios ofrecidos)
// ============================================================

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @default("") @db.Text
  category    String
  icon        String   @default("")
  features    String[]
  image       String   @default("")
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}

// ============================================================
// CONFIGURACIÓN DEL SITIO (singleton)
// ============================================================

model SiteSettings {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// ANALYTICS
// ============================================================

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String   @default("")
  userAgent String   @default("")
  timestamp DateTime @default(now())

  @@index([path])
  @@index([timestamp])
}

// ============================================================
// INVENTARIO INTERNO (materiales para presupuestos de servicios)
// ============================================================

model Material {
  id          String   @id @default(cuid())
  code        String   @default("")
  description String
  unit        String   @default("un")
  unitPrice   Decimal  @db.Decimal(14, 2)
  provider    String   @default("")
  category    String   @default("general")
  isActive    Boolean  @default(true)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([description])
  @@index([category])
}

// ============================================================
// BANNERS PROMOCIONALES (flyers de tienda / servicios)
// ============================================================

model PromoBanner {
  id          String   @id @default(cuid())
  title       String   @default("")
  subtitle    String   @default("")
  ctaLabel    String   @default("")
  ctaUrl      String   @default("")
  imageUrl    String   @default("")
  bgColor     String   @default("#0a1628")
  accentColor String   @default("#2D8FCC")
  badge       String   @default("")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ============================================================
// CARRUSEL DEL HERO (slides con foto de trabajos)
// ============================================================

model CarouselSlide {
  id          String   @id @default(cuid())
  label       String
  tag         String   @default("")
  description String   @default("") @db.Text
  photoUrl    String   @default("")
  accent      String   @default("#2D8FCC")
  gradient    String   @default("from-[#0a1628] via-[#1a3a5c] to-[#0d2340]")
  overlayOpacity Int      @default(55)
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, order])
}

// ============================================================
// CLIENTES (confirmados — vienen de presupuestos aprobados)
// ============================================================

model Cliente {
  id            String   @id @default(cuid())
  name          String
  company       String   @default("")
  email         String   @default("")
  phone         String   @default("")
  address       String   @default("")
  ruc           String   @default("")
  category      String   @default("servicios") // servicios | tienda | ambos
  notes         String   @default("") @db.Text
  tags          String[]
  totalSpent    Decimal  @db.Decimal(14, 2) @default(0)
  jobsCount     Int      @default(0)
  lastServiceAt String   @default("")
  leadId        String?  @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([isActive])
}

// ============================================================
// USUARIOS Y ROLES
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("vendedor") // admin | vendedor | tecnico
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String   @default("")
  role      String   @default("vendedor")
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
