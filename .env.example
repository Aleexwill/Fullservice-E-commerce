# Neon Postgres (dashboard → Connection Details)
# DATABASE_URL: connection string "pooled" (host con sufijo -pooler) — usar en runtime (Vercel serverless)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[PROJECT-ID]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: connection string "direct" (host sin -pooler) — usada solo por prisma migrate/db push
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[PROJECT-ID].[REGION].aws.neon.tech/neondb?sslmode=require"

# Sitio
NEXT_PUBLIC_SITE_URL="https://fullservice.com.py"
WHATSAPP_PHONE="+595971528800"

# IA (opcional — sin esto, /api/ai/mejorar-descripcion usa fallback por plantilla)
OPENAI_API_KEY=""

# Subida de imágenes de productos (Vercel Blob). En Vercel se autocompleta
# al conectar el Blob store al proyecto. Para probar en local, copiala desde
# Vercel → Storage → tu Blob store → .env.local.
BLOB_READ_WRITE_TOKEN=""

# Email transaccional (Resend — https://resend.com)
# 1. Creá una cuenta en resend.com y generá una API key en Settings → API Keys.
# 2. RESEND_FROM_EMAIL debe ser una dirección del dominio verificado en Resend
#    (Settings → Domains). Mientras el dominio no esté verificado podés usar
#    "onboarding@resend.dev" solo para pruebas (solo envía al email del dueño de la cuenta).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@tudominio.com"

# Auth admin
# ADMIN_PASSWORD_HASH se genera con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE_AQUI', 10))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
# SESSION_SECRET: cualquier string largo y aleatorio, ej: openssl rand -hex 32
SESSION_SECRET=""
