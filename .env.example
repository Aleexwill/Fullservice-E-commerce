# Supabase Postgres
# DATABASE_URL: conexión con pooling (pgbouncer, puerto 6543) — usar en runtime (Vercel serverless)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: conexión directa (puerto 5432) — usada solo por prisma migrate/db push
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
WHATSAPP_PHONE="+595971528800"

# IA (opcional — sin esto, /api/ai/mejorar-descripcion usa fallback por plantilla)
OPENAI_API_KEY=""

# Auth admin (fase de seguridad, se agrega en el siguiente paso)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
